rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return logado() && meuPerfil().role == 'administrador' && meuPerfil().ativo == true;
    }

    function minhaTurma() {
      return meuPerfil().turmaId;
    }

    // Turma dona de um período — usado para checar disciplinas/avaliações contra a turma do usuário.
    function turmaDoPeriodo(periodoId) {
      return get(/databases/$(database)/documents/periodos/$(periodoId)).data.turmaId;
    }

    // Turmas: leitura só para autenticados (o cadastro não usa mais dropdown de turmas —
    // usa o convite). O código de convite mora aqui, então não pode ser lido sem estar logado.
    // Escrita apenas por administradores.
    match /turmas/{turmaId} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // Convites de cadastro: dados públicos (turma/nome), sem o código — é a única coisa que
    // a tela de cadastro pode ler antes do login. "get" (por token conhecido) é público;
    // "list" (enumerar todos os convites) só admin, pra ninguém conseguir descobrir tokens.
    match /convites/{token} {
      allow get: if true;
      allow list, write: if souAdmin();
    }

    // Períodos (semestres de uma turma): leitura para qualquer autenticado
    // (precisa resolver o período em curso da própria turma); escrita só admin.
    match /periodos/{periodoId} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // Usuários: cada um lê/edita (parcialmente) o próprio perfil; admin gerencia todos.
    // Leitura também liberada para colegas da mesma turma (não só self/admin) desde
    // 2026-07-31, para a página /ranking — cada aluno precisa ler nome/avatar/xp dos
    // demais da própria turma para montar a lista ordenada por XP. Isso também expõe
    // email/role/ativo do documento inteiro aos colegas (regras do Firestore não fazem
    // masking por campo) — aceitável numa turma pequena e já confiável entre si, mas é
    // uma mudança real de superfície de exposição de dados, registrada aqui de propósito.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souAdmin() || resource.data.turmaId == minhaTurma());

      // Cadastro (autocadastro): só o próprio usuário criando o próprio doc,
      // sempre como 'aluno', vinculado a uma turma existente, e só se o código de
      // autorização enviado bater com o código real da turma (nunca lido antes daqui —
      // o get() abaixo roda com acesso total, independente da regra de leitura de "turmas").
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.role == 'aluno'
        && request.resource.data.ativo == true
        && exists(/databases/$(database)/documents/turmas/$(request.resource.data.turmaId))
        && request.resource.data.codigoConvite == get(/databases/$(database)/documents/turmas/$(request.resource.data.turmaId)).data.codigoConvite;

      // O próprio usuário pode alterar nome/avatar (perfil) — nunca papel, turma ou status.
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.turmaId == resource.data.turmaId
        && request.resource.data.ativo == resource.data.ativo;

      allow update, delete: if souAdmin();
    }

    // Módulos de horário (blocos de horário de uma turma, ex: M1 = 07:00 às 08:40):
    // só o admin precisa ler/escrever — os alunos só veem o horário já resolvido
    // dentro do próprio documento da disciplina.
    match /modulos_horario/{moduloId} {
      allow read, write: if souAdmin();
    }

    // Disciplinas: alunos/admin leem só as do período cuja turma é a própria; escrita só por admin.
    match /disciplinas/{disciplinaId} {
      allow read: if logado() && (turmaDoPeriodo(resource.data.periodoId) == minhaTurma() || souAdmin());
      allow create: if souAdmin();
      allow update, delete: if souAdmin();
    }

    // Avaliações: mesma regra de disciplinas, escopadas por período.
    match /avaliacoes/{avaliacaoId} {
      allow read: if logado() && (turmaDoPeriodo(resource.data.periodoId) == minhaTurma() || souAdmin());
      allow create: if souAdmin();
      allow update, delete: if souAdmin();
    }

    // Progresso: cada aluno lê/escreve o próprio; admin lê tudo (acompanhamento) e, desde
    // 2026-08-03, também pode ATUALIZAR (não criar) — usado pela ação administrativa de
    // zerar o XP de todos em /admin/usuarios (correção pontual, não uma abertura geral;
    // "create" continua só do próprio dono, o doc inicial de cada aluno nasce só no
    // primeiro login dele, nunca criado por outra pessoa).
    match /progresso/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souAdmin());
      allow create: if logado() && request.auth.uid == uid;
      allow update: if logado() && (request.auth.uid == uid || souAdmin());

      // Ledger de XP (append-only) — cada aluno lê/cria o próprio; admin também lê tudo e,
      // pelo mesmo motivo acima, pode CRIAR um lançamento (nunca editar/apagar um já feito)
      // em nome de outro usuário — é assim que a ação de reset registra a correção no
      // histórico de cada um.
      match /historico/{eventoId} {
        allow read: if logado() && (request.auth.uid == uid || souAdmin());
        allow create: if logado() && (request.auth.uid == uid || souAdmin());
      }
    }

    // Gamificação por período (selos, bônus de XP de atividade/disciplina, dias de
    // login) — zera a cada novo período em curso, por isso é um doc separado de
    // "progresso" (que é vitalício). Doc id "{uid}_{periodoId}"; cada aluno só
    // lê/escreve o próprio, verificado pelo campo "uid" dentro do documento.
    //
    // A checagem `!exists(...)` no "read" é essencial, não estilo: pra um doc que AINDA
    // não existe (todo aluno, na primeira vez que gamificação avalia um período novo),
    // `resource` é null — referenciar `resource.data.uid` nesse caso é um ERRO de
    // avaliação, não `false`. Erro em um operando do `||` só é "absorvido" se o OUTRO
    // operando for `true` — o que só acontecia pra admins (`souAdmin()` verdadeiro
    // mascarava o erro). Pra qualquer aluno normal, `souAdmin()` é false, o erro do lado
    // esquerdo se propaga, e o `onSnapshot`/`get` inteiro falhava com permission-denied —
    // GamificacaoService nunca conseguia nem checar "existe?" pra então criar o doc
    // vazio, então TODA a gamificação (XP de login, de atividade, de disciplina, selos)
    // ficava travada em zero pra qualquer aluno cujo progresso_periodo do período atual
    // ainda não existisse. `!exists(...)` primeiro no OR faz o caminho "não existe ainda"
    // sempre retornar true sem nunca chegar a ler `resource.data` (exists() não erra pra
    // doc inexistente, é literalmente pra isso que serve) — só depois disso é seguro
    // comparar `resource.data.uid` pra um doc que se sabe existir.
    match /progresso_periodo/{docId} {
      allow read: if logado() && (
        !exists(/databases/$(database)/documents/progresso_periodo/$(docId)) ||
        resource.data.uid == request.auth.uid ||
        souAdmin()
      );
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update: if logado() && resource.data.uid == request.auth.uid;
    }
  }
}
